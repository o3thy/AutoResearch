{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rr-result.schema.json",
  "title": "ResearchRabbit discovery result",
  "type": "object",
  "required": ["schema_version", "platform", "source", "operation", "status", "captured_at", "seed_papers", "related_papers", "pages", "duplicates", "gaps", "coverage"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "platform": {"const": "ResearchRabbit"},
    "source": {"enum": ["live_browser", "saved_html"]},
    "operation": {"type": "string"},
    "query": {"type": ["string", "null"]},
    "status": {"enum": ["ok", "partial", "empty", "login_required", "blocked", "error", "dom_changed", "ambiguous_seed", "seed_mismatch"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "seed_papers": {"type": "array", "items": {"$ref": "paper.schema.json"}},
    "related_papers": {"type": "array", "items": {"$ref": "paper.schema.json"}},
    "authors_to_watch": {"type": "array"},
    "clusters": {"type": "array"},
    "next_searches": {"type": "array", "items": {"type": "string"}},
    "pages": {"type": "array", "items": {"type": "object"}},
    "duplicates": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "coverage": {
      "type": "object",
      "required": ["reported_total", "raw_count", "unique_count", "complete"],
      "properties": {
        "reported_total": {"type": ["integer", "null"], "minimum": 0},
        "raw_count": {"type": "integer", "minimum": 0},
        "unique_count": {"type": "integer", "minimum": 0},
        "complete": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
